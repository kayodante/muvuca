# Copie este arquivo para .env.local e preencha os valores.
#   cp .env.example .env.local
#
# Todas as variáveis abaixo são NEXT_PUBLIC_ (públicas, inlined no bundle do
# cliente) por design: o Muvuca nunca usa uma chave secreta ou service_role
# no servidor Next.js. Veja lib/validation/env.ts para a validação em tempo
# de boot e docs/ARQUITETURA.md para o porquê dessa restrição.

# URL do projeto Supabase. Para o stack local (supabase start), use o valor
# padrão abaixo. Para um projeto próprio, use a URL do painel do Supabase
# (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave publicável (prefixo sb_publishable_) do projeto Supabase. Nunca use
# a service_role key aqui — ela nunca deve existir no frontend nem no
# servidor Next.js. Para o stack local, `supabase start` imprime esse valor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# URL pública onde a aplicação Next.js está servida. Usada para montar o
# link de confirmação do magic link e como allow-list de redirect.
NEXT_PUBLIC_APP_URL=http://localhost:3000
